# Local Node connections; Compose uses its internal postgres hostname.
DATABASE_URL=postgres://wallet:wallet-local@127.0.0.1:5433/wallet
ADMIN_TOKEN=local-admin-change-me
PORT=3000
API_PORT=18080
POSTGRES_PORT=5433
RECONCILIATION_HOUR_UTC=0

# Set this key to enable OpenRouter. Blank keeps the mock active.
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=apodex/apodex-1.1-mini:free

# Fixture resets stay disabled unless explicitly enabled for a command.
ALLOW_SEED_RESET=false
ALLOW_TEST_RESET=false
SEED_TRANSFERS=100000
DEMO_BASE_URL=http://127.0.0.1:18080
